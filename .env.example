# INTS Institutional Voting System - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Password required to access the admin moderation panel (/admin) and delete candidates.
# In production, this MUST be set to a strong, non-default password.
ADMIN_PASSWORD=change_this_to_a_strong_password

# Secret key used by Flask to cryptographically sign session cookies.
# Generate a strong key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production

# ==============================================================================
# Network & Server
# ==============================================================================
# Host interface to bind server (0.0.0.0 allows LAN/external connections; 127.0.0.1 for local only)
HOST=0.0.0.0
# TCP port for the web service (institutional default: 9090)
PORT=9090

# ==============================================================================
# Storage & Persistence
# ==============================================================================
# Path to SQLite database file (relative to project root or absolute path)
DATABASE_PATH=data/voting.db

# Path to directory where participant photos will be stored (relative or absolute)
UPLOAD_FOLDER=static/uploads

# Maximum permitted upload size in bytes (10485760 bytes = 10 MB)
MAX_CONTENT_LENGTH=10485760

# ==============================================================================
# Application Mode
# ==============================================================================
# Options: development | production | testing
APP_ENV=production
