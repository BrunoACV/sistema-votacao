# Ambientes virtuais Python
.venv/
venv/
env/
ENV/

# Caches e artefatos de compilação Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log

# O .env FICA NO REPOSITORIO, seguindo o padrao institucional definido para o
# colega de infraestrutura: ele clona e o projeto sobe imediatamente via Docker
# Compose sem depender de configuracoes externas.
#
# A consequencia: este repositorio contem as configuracoes operacionais e a
# chave de sessao. Por isso:
#   - o repositorio tem de continuar PRIVADO;
#   - se for tornado publico algum dia, as senhas devem ser trocadas antes.
# .env

# Sobrescritas locais que NAO devem ir para o Git
.env.local

# O banco de dados SQLite oficial (data/voting.db) e fotos (static/uploads)
# FICAM NO REPOSITORIO conforme solicitacao, para que o analista de infraestrutura
# clone o projeto e ele suba imediatamente com a copia exata dos dados de hoje.
data/*.db-wal
data/*.db-shm
data/*.tmp

# Artefatos temporarios de agentes e auditoria
.agents/
_aud*
_ref*
_t*.*
aud-tmp.*

# Arquivos do sistema operacional
Thumbs.db
Desktop.ini
.DS_Store
